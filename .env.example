# Copy to .env (gitignored) for local runs. On Hugging Face, set these as Space secrets or
# variables instead: see docs/deploy.md. Never commit real values.

ANTHROPIC_API_KEY=

# Public deployments (all optional; unset means off):
# SPELLFORGE_ACCESS_CODE=a-long-random-invite-code
# SPELLFORGE_DAILY_BUDGET_USD=5
# SPELLFORGE_MAX_SESSIONS=20
# Where the leaderboard is saved (unset: in memory, lost on restart):
# SPELLFORGE_DATA_DIR=.data

# Development:
# SPELLFORGE_DEV_TOOLS=1
# SPELLFORGE_FORGE_MODE=single
